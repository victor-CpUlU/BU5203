# A copy of this file is created as .env on first launch. Fill in your own values. Never commit .env.
#
# LLM_PROVIDER: kiro_cli | openai | gemini | anthropic
#   kiro_cli  - uses your Kiro subscription through the Kiro CLI (headless mode).
#               Install: PowerShell -> irm 'https://cli.kiro.dev/install.ps1' | iex   (Windows 11)
#               Then either run `kiro-cli login` once, or put a Kiro API key (app.kiro.dev > API Keys,
#               Pro / Pro+ / Pro Max / Power plans) in LLM_API_KEY. LLM_MODEL may be left blank.
#   openai    - e.g. LLM_MODEL=gpt-4o-mini
#   gemini    - e.g. LLM_MODEL=gemini-2.5-flash (Google AI Studio key, has a free tier)
#   anthropic - e.g. LLM_MODEL=claude-sonnet-4-5
LLM_PROVIDER=kiro_cli
LLM_MODEL=
LLM_API_KEY=
# Optional: full path to kiro-cli if it is not on PATH
KIRO_CLI_PATH=
# Optional AI preliminary support check in Section 6 (true / false)
SUPPORT_CHECK_ENABLED=false
# Local port (the app always listens on 127.0.0.1)
PORT=8000
# Path to the financial database workbook (relative to the project folder)
FINANCIAL_DB_PATH=Semiconductor_Financial_Performance_Indicators_Combined.xlsx
